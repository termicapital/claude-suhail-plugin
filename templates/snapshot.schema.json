{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mord Snapshot Schema",
  "description": "Deterministic snapshot of the Mord master template",
  "type": "object",
  "required": ["version", "source_file_key", "slides"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "source_file_key": {
      "type": "string",
      "description": "Figma file key of the master template"
    },
    "lastModified": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification time of the Figma file (from Figma's API). Changes only when the template is edited — safe for idempotency."
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide_index", "name", "section_id", "id"],
        "properties": {
          "slide_index": {
            "type": "integer",
            "description": "1-based position in the deck (cover=1, closing=18)"
          },
          "name": {
            "type": "string",
            "description": "Slide name as stored in Figma (currently '1'..'18'; may include section=<id> suffix in the future)"
          },
          "section_id": {
            "type": "string",
            "description": "Section identifier. Parsed from slide name if encoded, else derived from slide_index via the canonical position→section map in scripts/snapshot_template.py."
          },
          "id": {
            "type": "string",
            "description": "Figma node ID"
          },
          "background": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["SOLID"] },
              "color": {
                "type": "object",
                "properties": {
                  "r": { "type": "number" },
                  "g": { "type": "number" },
                  "b": { "type": "number" }
                }
              }
            }
          },
          "children": {
            "type": "array",
            "description": "Recursive node tree"
          }
        }
      }
    }
  }
}
